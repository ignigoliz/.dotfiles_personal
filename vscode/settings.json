{
    "workbench.tree.indent": 18, // hide bottom bar
    "workbench.colorTheme": "Railgun",
    "workbench.colorCustomizations": {
        "editorRuler.foreground": "#3d393a",
        "editor.wordHighlightTextBorder": "#DB9833",
        "notebook.focusedCellBorder": "#DB9833",
        "notebook.focusedEditorBorder": "#DB9833",
        "sash.hoverBorder": "#DB9833",
        "textLink.foreground": "#DB9833",
        "textLink.activeForeground": "#E8A93D",
    },
    "notebook.output.textLineLimit": 100,
    "editor.fontSize": 15,
    "editor.lineHeight": 1.42857, // height multiplier; makes font size 14 have line height of 14px*1.42=~20px
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    "files.autoSaveDelay": 1,
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.inheritEnv": false,
    "terminal.integrated.defaultProfile.osx": "zsh",
    "python.createEnvironment.trigger": "off",
    "python.analysis.typeCheckingMode": "standard",
    "notebook.diff.experimental.toggleInline": true,
    "debug.onTaskErrors": "showErrors",
    "security.workspace.trust.untrustedFiles": "open",
    "window.confirmSaveUntitledWorkspace": false,
    "explorer.confirmPasteNative": false,
    "editor.parameterHints.cycle": false,
    "editor.parameterHints.enabled": false,
    "editor.inlineSuggest.showToolbar": "never",
    "editor.quickSuggestionsDelay": 300,
    "editor.suggest.matchOnWordStartOnly": false,
    "files.exclude": {
        "**/__pycache__": true
    },
    "extensions.ignoreRecommendations": true,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "chat.commandCenter.enabled": false,
    "editor.formatOnSave": true,
    "window.title": "${dirty}${activeEditorShort}${separator}${folderPath}",
    "editor.rulers": [
        88,
    ],
    "workbench.sideBar.location": "right",
    "editor.allowVariableFontsInAccessibilityMode": true,
    "terminal.integrated.fontFamily": "Google Sans Code, monospace",
    "editor.fontFamily": "Google Sans Code, Menlo, monospace",
    "git.openRepositoryInParentFolders": "always",
    "workbench.editor.empty.hint": "hidden",
    "editor.inlayHints.enabled": "offUnlessPressed",
    "rust-analyzer.completion.autoimport.enable": false,
    "rust-analyzer.checkOnSave": false,
    "rust-analyzer.check.command": "clippy",
    "claudeCode.preferredLocation": "panel",
    "workbench.activityBar.location": "top",
    "chat.disableAIFeatures": true,
    "liveServer.settings.donotShowInfoMsg": true,
    "security.promptForLocalFileProtocolHandling": false,
    "claudeCode.hideOnboarding": true,
    "editor.codeLensFontFamily": "Google Sans Code, Menlo, monospace",
    "claudeCode.useTerminal": true,
}